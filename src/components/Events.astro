---
// Seção 7 — Eventos e projetos (confirmados no Instagram) + faixa CTA para o Instagram oficial.
import SectionHeader from './SectionHeader.astro';
import EventCard from './EventCard.astro';
import { content, ok } from '../lib/content';

const TONS: Record<string, 'pink' | 'sky' | 'yellow'> = {
  'sete-setembro': 'sky',
  inclusao: 'sky',
  'semana-crianca': 'pink',
  'fonte-folia': 'yellow',
};
const eventos = content.eventos.filter((e) => ok(e.status));
const insta = content.contato.instagram;
---
{eventos.length > 0 && (
  <section class="section" id="eventos" aria-labelledby="eventos-title">
    <div class="container">
      <SectionHeader id="eventos-title" eyebrow="Eventos e projetos" hand="a escola em festa!">
        Um ano cheio de <span class="hl">projetos</span>
        <Fragment slot="lead">Datas e projetos que as famílias acompanham ao longo do ano.</Fragment>
      </SectionHeader>
      <div class="grid grid--3">
        {eventos.map((e, i) => <EventCard ev={e} tone={TONS[e.id]} i={i} />)}
      </div>
      {ok(insta.status) && (
        <div class="cta-band cta-band--after">
          <div class="stack">
            <h3 class="cta-band__title">Acompanhe a rotina no Instagram</h3>
            <p>Fotos dos projetos, avisos e datas importantes no perfil oficial da escola.</p>
          </div>
          <a class="btn btn--secondary" href={insta.valor} rel="noopener" target="_blank"><svg class="icon btn__icon" aria-hidden="true"><use href="#i-insta" /></svg>Ver {insta.handle}</a>
        </div>
      )}
    </div>
  </section>
)}
